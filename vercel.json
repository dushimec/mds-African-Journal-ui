{
  "rewrites": [
    {
      "source": "/article/pdf/vol:volume/issue:issue/:slug",
      "destination": "https://api.jaedp.org/api/v1/article/pdf/vol:volume/issue:issue/:slug"
    },
    {
      "source": "/article/pdf/vol:volume/issue:issue/:slug*.pdf",
      "destination": "https://api.jaedp.org/api/v1/article/pdf/vol:volume/issue:issue/:slug.pdf"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

